.venv/
__pycache__/
*.pyc
.pytest_cache/
# never commit transcripts or media
output/
transcripts/
*.mkv
*.mp4
*.srt
*.vtt
# capture secrets / state (Windows box)
acquire/obs_config.toml
acquire/.browser-profile/
acquire/episodes.txt
logs/
# generated test video (created on obs-machine via generate-test-video)
test_assets/test_video.mp4
# OBS machine data files (generated catalogs, queues)
catalog_*.json
*_queue.json
data/patreon_full_catalog.json
# SQLite runtime database files
data/*.db
data/*.db-shm
data/*.db-wal
# App review reports (generated, not source)
app_review/
# Environment variables (secrets)
.env
# Insights frontend build artifacts (also ignored via frontend/.gitignore)
frontend/node_modules/
frontend/dist/
# Windows agent-control logs (accidentally committed)
C\:\\Users\\*
